# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# Your MongoDB connection string (MongoDB Atlas free tier works fine)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/treasurehunt

# Any long random string, used to sign login sessions
JWT_SECRET=change-this-to-something-long-and-random

# Password the ADMIN uses to view the live dashboard at /admin.html
ADMIN_PASSWORD=change-this-admin-password

# Port the server runs on locally
PORT=3000

# The public URL of your deployed site, e.g. https://karunya-hunt.onrender.com
# Used only by generate-qrcodes.js to build the QR code links.
BASE_URL=http://localhost:3000
